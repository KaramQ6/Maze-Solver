+void Window::showStartMarker() {
+  auto graphic = m_truth->getMazeGraphic();
+  graphic->setColor(m_robotStart.x, m_robotStart.y, Color::CYAN);
+  graphic->setText(m_robotStart.x, m_robotStart.y,
+                   "S:" + QString(m_robotStart.headingChar()).toUpper());
+}
+
+void Window::onStartButtonPressed() {
+  StartDialog dialog(m_robotStart, QSize(mazeWidth(), mazeHeight()), this);
+  if (dialog.exec() != QDialog::Accepted) {
+    return;
+  }
+  auto selected = dialog.selectedStart();
+  if (selected.x == m_robotStart.x && selected.y == m_robotStart.y &&
+      selected.heading == m_robotStart.heading) {
+    return;
+  }
+  bool restart = m_runProcess != nullptr;
+  cancelRun();
+  auto graphic = m_truth->getMazeGraphic();
+  graphic->clearColor(m_robotStart.x, m_robotStart.y);
+  int distance = m_maze->getTile(m_robotStart.x, m_robotStart.y)->getDistance();
+  graphic->setText(m_robotStart.x, m_robotStart.y,
+                   distance >= 0 ? QString::number(distance) : "inf");
+  m_robotStart = selected;
+  saveRobotStart(m_currentMazeFile, m_robotStart);
+  stats->resetAll();
+  showStartMarker();
+  refreshRobotSummary();
+  if (restart) {
+    startRun();
+  }
+}
+
+void Window::onRobotSpeedButtonPressed() {
+  TimingDialog dialog(m_motionTiming, this);
+  if (dialog.exec() != QDialog::Accepted) {
+    return;
+  }
+  m_motionTiming = dialog.selectedTiming();
+  saveMotionTiming(m_motionTiming);
+  refreshRobotSummary();
+}
+
+bool Window::isAtSelectedStart() const {
+  return m_startingPosition.x == 2 * m_robotStart.x + 1 &&
+         m_startingPosition.y == 2 * m_robotStart.y + 1;
+}
+
+void Window::beginMovementTiming() {
+  double cellSeconds = m_speedRunMode ? m_motionTiming.speedCellSeconds
+                                     : m_motionTiming.searchCellSeconds;
+  if (m_movement == Movement::MOVE_STRAIGHT || m_movement == Movement::MOVE_DIAGONAL) {
+    m_activeMovementSeconds = cellSeconds * m_halfStepsToMoveForward / 2.0;
+    if (m_movement == Movement::MOVE_DIAGONAL) {
+      m_activeMovementSeconds *= qSqrt(2.0);
+    }
+  } else {
+    bool halfTurn = m_movement == Movement::TURN_LEFT_45 || m_movement == Movement::TURN_RIGHT_45;
+    m_activeMovementSeconds = m_motionTiming.turn90Seconds * (halfTurn ? 0.5 : 1.0);
+  }
+  m_movementClock.start();
+}
+
+double Window::elapsedMovementProgress() {
+  double seconds = m_movementClock.nsecsElapsed() / 1e9;
+  m_movementClock.start();
+  return progressRequired(m_movement) * seconds / m_activeMovementSeconds;
+}
